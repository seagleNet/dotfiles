# Private host blocks live in untracked files pulled from Bitwarden
# (`dot secrets pull`). Included first so their settings take precedence.
Include config.d/*

Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    ControlMaster no

Host gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    ControlMaster no

Host *
    ControlMaster auto
    ControlPersist 30m
    ControlPath ~/.ssh/S.%r@%h:%p
    ServerAliveInterval 15
