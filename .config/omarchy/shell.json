{
  "bar": {
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "bitr0t.system-monitor",
          "chipMode": "minimal",
          "monitors": [
            "cpu",
            "memory",
            "network"
          ]
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "im0001gt.screens"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.elsewhen",
          "zones": "Zurich|Europe/Zurich, Delhi|Asia/Kolkata, Tokyo|Asia/Tokyo, Los Angeles|America/Los_Angeles, New York|America/New_York"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.scrambletools.auto-timezone",
          "automatic": true
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "tray": []
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ],
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "terminal",
      "boot": "follow",
      "openAs": "full"
    }
  ],
  "version": 1
}
