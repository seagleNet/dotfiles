# Private files synced with Bitwarden by `dot secrets`, never committed.
# Each is stored as the secure note "dotfiles/<name>". Manage entries with
# `dot secrets add <name> <file>` or edit this file, then run `dot setup`.
#
# <name>         <path relative to ~>
ssh-private      .ssh/config.d/private
ssh-work         .ssh/config.d/work
gitconfig-work   .gitconfig-work
bashrc-work      .bashrc_work
denylist         .config/dotfiles/denylist
ssh-key-id_ecdsa .ssh/id_ecdsa
ssh-key-id_ed25519 .ssh/id_ed25519
ssh-key-google_compute_engine .ssh/google_compute_engine
