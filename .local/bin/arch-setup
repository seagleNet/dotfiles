#!/usr/bin/env bash
# Install the packages these dotfiles expect on Arch (incl. WSL and Omarchy).
# Safe to re-run: pacman --needed skips what's already installed.
set -euo pipefail

sudo -E pacman -Syu --needed \
    ast-grep \
    base-devel \
    bat \
    chafa \
    cpanminus \
    eza \
    fd \
    fish \
    fzf \
    git \
    github-cli \
    glab \
    jq \
    lazygit \
    less \
    lua \
    lua51 \
    luarocks \
    markdownlint-cli2 \
    neovim \
    npm \
    odin \
    odinfmt \
    openssh \
    packer \
    prettier \
    python-black \
    python-isort \
    python-pip \
    python-pynvim \
    ripgrep \
    ruby \
    shfmt \
    starship \
    stylua \
    terraform \
    texlive-latex \
    tree-sitter-cli \
    ueberzugpp \
    unzip \
    viu \
    wget \
    yamlfmt \
    zip

# neovim language providers (python comes from python-pynvim)
gem install --user-install neovim
sudo /usr/bin/vendor_perl/cpanm -n Neovim::Ext
