#!/usr/bin/env bash
# dot - manage dotfiles kept in a bare git repo with $HOME as work tree.
#
#   dot <git args>        run git against the dotfiles repo (dot status, dot add, ...)
#   dot bootstrap [url]   clone the repo onto a fresh machine and run setup
#   dot setup             (re)apply machine setup: pre-commit hook, fisher plugins,
#                         omarchy plugins
#   dot secrets pull|push|status [name...]
#                         sync private files with Bitwarden secure notes
#   dot secrets add <name> <file>
#                         register a file as a secret and push it to Bitwarden
set -euo pipefail

DOT_DIR="${DOT_DIR:-$HOME/.dotfiles}"
DOT_URL="https://github.com/seagleNet/dotfiles.git"
DOT_PUSH_URL="git@github.com:seagleNet/dotfiles.git"

# Private files never tracked in git, one "<name> <path relative to ~>" per
# line. Each is stored in Bitwarden as a secure note named "dotfiles/<name>".
SECRETS_FILE="$HOME/.config/dotfiles/secrets"

g() { git --git-dir="$DOT_DIR" --work-tree="$HOME" "$@"; }
info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m::\033[0m %s\n' "$*" >&2; }
die() {
    printf '\033[1;31m::\033[0m %s\n' "$*" >&2
    exit 1
}

# Read $SECRETS_FILE into SECRETS as "name|path" entries. Missing file (e.g.
# during bootstrap, before checkout) means no secrets.
load_secrets() {
    SECRETS=()
    [[ -f $SECRETS_FILE ]] || return 0
    local name path
    while read -r name path; do
        [[ -z $name || $name == \#* ]] && continue
        SECRETS+=("$name|$path")
    done <"$SECRETS_FILE"
}

# Keep secret paths ignored so a stray `dot add` refuses them.
write_excludes() {
    local entry
    {
        echo "# managed by dot - secret files, see 'dot secrets'"
        for entry in "${SECRETS[@]}"; do echo "/${entry#*|}"; done
    } >"$DOT_DIR/info/exclude"
}

cmd_bootstrap() {
    local url="${1:-$DOT_URL}"
    [[ -e $DOT_DIR ]] && die "$DOT_DIR already exists"
    command -v git >/dev/null || die "git is required"

    info "cloning $url"
    git clone --bare "$url" "$DOT_DIR"
    g config status.showUntrackedFiles no
    [[ $url == "$DOT_URL" ]] && g remote set-url --push origin "$DOT_PUSH_URL"

    # Back up any existing files that would be overwritten by checkout.
    local backup f
    backup="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
    while IFS= read -r f; do
        [[ -e $HOME/$f || -L $HOME/$f ]] || continue
        mkdir -p "$backup/$(dirname "$f")"
        mv "$HOME/$f" "$backup/$f"
    done < <(g ls-tree -r --name-only HEAD)
    [[ -d $backup ]] && info "backed up existing files to $backup"

    g checkout
    load_secrets
    cmd_setup
    info "done - run 'dot secrets pull' to fetch private config from Bitwarden"
}

# Refuse commits whose added lines match the private denylist (regexes, one per
# line, case-insensitive). The list itself is a secret, so it can't live in the
# public repo; without it the hook does nothing.
write_hook() {
    mkdir -p "$DOT_DIR/hooks"
    cat >"$DOT_DIR/hooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
# installed by `dot setup`
list="$HOME/.config/dotfiles/denylist"
[[ -s $list ]] || exit 0
patterns=$(grep -Ev '^[[:space:]]*(#|$)' "$list") || exit 0
if hits=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -Ev '^\+\+\+ ' |
    grep -inE -- "$patterns"); then
    printf '\033[1;31m::\033[0m commit blocked, staged lines match %s:\n%s\n' "$list" "$hits" >&2
    exit 1
fi
EOF
    chmod +x "$DOT_DIR/hooks/pre-commit"
}

cmd_setup() {
    write_excludes
    write_hook
    chmod 700 "$HOME/.ssh" 2>/dev/null || true

    # stdin from /dev/null: fisher reads plugin names from a non-tty stdin, which
    # under `curl ... | bash` would be the rest of this script
    if command -v fish >/dev/null; then
        info "installing fisher plugins"
        fish -c 'type -q fisher; or curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source; fisher update' </dev/null ||
            warn "fisher update failed"
    fi

    local list="$HOME/.config/dotfiles/omarchy-plugins" url
    if command -v omarchy >/dev/null && [[ -f $list ]]; then
        info "installing omarchy shell plugins"
        while IFS= read -r url; do
            [[ -z $url || $url == \#* ]] && continue
            omarchy plugin list 2>/dev/null | grep -q "$(basename "$url" .git | sed 's/^omarchy-//')" && continue
            omarchy plugin add "$url" --yes </dev/null || warn "failed to add $url"
        done <"$list"
    fi
}

bw_session() {
    command -v bw >/dev/null || die "bitwarden cli (bw) is not installed"
    command -v jq >/dev/null || die "jq is required"
    local status
    status=$(bw status | jq -r .status)
    case $status in
    unauthenticated) die "run 'bw login' first" ;;
    locked)
        BW_SESSION=$(bw unlock --raw) || die "unlock failed"
        export BW_SESSION
        ;;
    esac
    bw sync >/dev/null
}

# Resolve requested names (default: all) to "name|path" entries.
select_secrets() {
    local entry name
    if (($# == 0)); then
        if ((${#SECRETS[@]})); then printf '%s\n' "${SECRETS[@]}"; fi
        return
    fi
    for name in "$@"; do
        for entry in "${SECRETS[@]}"; do
            [[ ${entry%%|*} == "$name" ]] && {
                echo "$entry"
                continue 2
            }
        done
        die "unknown secret '$name' (known: $(printf '%s ' "${SECRETS[@]%%|*}"))"
    done
}

# Every bw call starts a node process (~1s), so fetch all dotfiles notes once.
load_items() {
    ITEMS=$(bw list items --search dotfiles/)
}

# Prints the stored item JSON for an exact name match, or nothing.
item_json() {
    jq -c --arg n "dotfiles/$1" 'first(.[] | select(.name == $n)) // empty' <<<"$ITEMS"
}

# Notes hold at most 10000 encrypted characters (~7.4 KB of text). Larger or
# binary files go into an attachment on the same item (needs Premium); its
# notes then carry a marker with the file's checksum and attachment id.
NOTE_MAX_BYTES=7000
MARKER_RE='^dot:attachment sha256=([0-9a-f]{64}) id=([^[:space:]]+)'

# True for text files small enough to store as a note.
fits_note() {
    (($(wc -c <"$1") <= NOTE_MAX_BYTES)) &&
        tr -d '\000' <"$1" | cmp -s - "$1" &&
        iconv -f UTF-8 -t UTF-8 "$1" >/dev/null 2>&1
}

sha256() { sha256sum "$1" | cut -d' ' -f1; }

# create_item <name> <jq args defining $n>: new secure note, prints its JSON.
create_item() {
    local name=$1
    shift
    jq -n --arg name "dotfiles/$name" "$@" \
        '{type: 2, name: $name, notes: $n, secureNote: {type: 0}, organizationId: null,
          folderId: null, favorite: false, fields: [], reprompt: 0}' |
        base64 -w0 | bw create item
}

# set_notes <item json> <jq args defining $n>: replace the notes, prints the item.
set_notes() {
    local item=$1
    shift
    jq "$@" '.notes = $n' <<<"$item" | base64 -w0 | bw edit item "$(jq -r .id <<<"$item")"
}

# delete_attachments <item id> <attachment id...>
delete_attachments() {
    local item_id=$1 att
    shift
    for att in "$@"; do bw delete attachment "$att" --itemid "$item_id" >/dev/null; done
}

push_secret() {
    local name=$1 path=$2 item old hash marker new_id
    item=$(item_json "$name")

    if fits_note "$path"; then
        if [[ -z $item ]]; then
            create_item "$name" --rawfile n "$path" >/dev/null
            info "created dotfiles/$name"
        elif jq -e --rawfile n "$path" '.notes == $n' <<<"$item" >/dev/null; then
            info "unchanged dotfiles/$name"
        else
            mapfile -t old < <(jq -r '.attachments[]?.id' <<<"$item")
            set_notes "$item" --rawfile n "$path" >/dev/null
            # drop attachments left from when the file was too large for a note
            delete_attachments "$(jq -r .id <<<"$item")" "${old[@]}"
            info "updated dotfiles/$name"
        fi
        return
    fi

    hash=$(sha256 "$path")
    if [[ -n $item && $(jq -r '.notes // ""' <<<"$item") =~ $MARKER_RE ]] &&
        [[ ${BASH_REMATCH[1]} == "$hash" ]] &&
        jq -e --arg id "${BASH_REMATCH[2]}" 'any(.attachments[]?; .id == $id)' <<<"$item" >/dev/null; then
        info "unchanged dotfiles/$name (attachment)"
        return
    fi
    [[ -n $item ]] || item=$(create_item "$name" --arg n "dot:attachment pending")
    mapfile -t old < <(jq -r '.attachments[]?.id' <<<"$item")

    # Upload first, then point the marker at it, then remove old attachments,
    # so an interrupted push leaves the previous version intact.
    item=$(bw create attachment --file "$path" --itemid "$(jq -r .id <<<"$item")")
    new_id=$(jq -r --args '[.attachments[] | select([.id] | inside($ARGS.positional) | not)][0].id // empty' \
        "${old[@]}" <<<"$item")
    [[ -n $new_id ]] || die "uploading $name failed"
    marker="dot:attachment sha256=$hash id=$new_id"$'\n\n'"Stored as an attachment by dot: too large or binary for a note."
    item=$(set_notes "$item" --arg n "$marker")
    delete_attachments "$(jq -r .id <<<"$item")" "${old[@]}"
    info "uploaded dotfiles/$name (attachment, $(wc -c <"$path") bytes)"
}

pull_secret() {
    local name=$1 path=$2 item tmp hash
    item=$(item_json "$name")
    if [[ -z $item ]]; then
        warn "skipping $name: no 'dotfiles/$name' note in bitwarden"
        return
    fi
    mkdir -p "$(dirname "$path")"
    tmp=$(mktemp)
    if [[ $(jq -r '.notes // ""' <<<"$item") =~ $MARKER_RE ]]; then
        hash=${BASH_REMATCH[1]}
        bw get attachment "${BASH_REMATCH[2]}" --itemid "$(jq -r .id <<<"$item")" --output "$tmp" >/dev/null
        if [[ $(sha256 "$tmp") != "$hash" ]]; then
            rm -f "$tmp"
            die "checksum mismatch for $name, ~/${path#"$HOME"/} left unchanged"
        fi
    else
        jq -j '.notes // ""' <<<"$item" >"$tmp"
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$path"
    info "pulled $name -> ~/${path#"$HOME"/}"
}

# dot secrets add <name> <file>: register a file under $HOME and push it.
secrets_add() {
    (($# == 2)) || die "usage: dot secrets add <name> <file>"
    local name=$1 file rel entry
    [[ $name =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
        die "invalid name '$name' (lowercase letters, digits, '.', '_', '-')"
    file=$(realpath -s -- "$2")
    [[ -f $file ]] || die "not a file: $2"
    [[ $file == "$HOME"/* ]] || die "$2 is not inside $HOME"
    rel=${file#"$HOME"/}
    [[ $rel != *[[:space:]]* ]] || die "paths with whitespace aren't supported"
    for entry in "${SECRETS[@]}"; do
        [[ ${entry%%|*} != "$name" ]] || die "secret '$name' already exists (~/${entry#*|})"
        [[ ${entry#*|} != "$rel" ]] || die "file ~/$rel is already the secret '${entry%%|*}'"
    done
    if g -C "$HOME" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
        die "file ~/$rel is tracked in the repo, untrack it first: dot rm --cached ~/$rel"
    fi

    mkdir -p "$(dirname "$SECRETS_FILE")"
    # keep the file newline-terminated before appending
    if [[ -s $SECRETS_FILE && $(tail -c1 "$SECRETS_FILE") ]]; then echo >>"$SECRETS_FILE"; fi
    printf '%-16s %s\n' "$name" "$rel" >>"$SECRETS_FILE"
    SECRETS+=("$name|$rel")
    write_excludes
    info "added $name -> ~/$rel"

    cmd_secrets push "$name"
    info "commit ~/${SECRETS_FILE#"$HOME"/} so other machines can 'dot secrets pull $name'"
}

cmd_secrets() {
    local action="${1:-status}"
    shift || true
    if [[ $action == add ]]; then
        secrets_add "$@"
        return
    fi
    local entry name path
    local entries
    mapfile -t entries < <(select_secrets "$@")

    case $action in
    status)
        for entry in "${entries[@]}"; do
            path="$HOME/${entry#*|}"
            printf '%-16s %-28s %s\n' "${entry%%|*}" "$HOME/${entry#*|}" "$([[ -f $path ]] && echo present || echo missing)"
        done
        ;;
    pull)
        bw_session
        load_items
        for entry in "${entries[@]}"; do
            pull_secret "${entry%%|*}" "$HOME/${entry#*|}"
        done
        ;;
    push)
        bw_session
        load_items
        for entry in "${entries[@]}"; do
            name=${entry%%|*} path="$HOME/${entry#*|}"
            [[ -f $path ]] || {
                (($# > 0)) && warn "skipping $name: ~/${entry#*|} missing"
                continue
            }
            push_secret "$name" "$path"
        done
        ;;
    *) die "usage: dot secrets pull|push|status [name...] | add <name> <file>" ;;
    esac
}

load_secrets

case "${1:-}" in
bootstrap)
    shift
    cmd_bootstrap "$@"
    ;;
setup) cmd_setup ;;
secrets)
    shift
    cmd_secrets "$@"
    ;;
"") g status ;;
*) g "$@" ;;
esac
