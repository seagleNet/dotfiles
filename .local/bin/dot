#!/usr/bin/env bash
# dot - manage dotfiles kept in a bare git repo with $HOME as work tree.
#
#   dot <git args>        run git against the dotfiles repo (dot status, dot add, ...)
#   dot bootstrap [url]   clone the repo onto a fresh machine and run setup
#   dot setup             (re)apply machine setup: pre-commit hook, fisher plugins,
#                         omarchy plugins
#   dot secrets pull|push [name...]
#                         sync private files with Bitwarden secure notes
#   dot secrets list [name...]
#                         configured secrets and whether the files exist locally
#   dot secrets status [name...]
#                         compare the files with Bitwarden (default action)
#   dot secrets add <name> <file>
#                         register a file as a secret and push it to Bitwarden
#   dot secrets rm [--keep-vault] <name>
#                         unregister a secret, moving its item to the Bitwarden trash
#
# Aliases: secret = secrets, ls = list, remove = rm, st = status
set -euo pipefail

DOT_DIR="${DOT_DIR:-$HOME/.dotfiles}"
DOT_URL="https://github.com/seagleNet/dotfiles.git"
DOT_PUSH_URL="git@github.com:seagleNet/dotfiles.git"

# Private files never tracked in git, one "<name> <path relative to ~>" per
# line. Each is stored in Bitwarden as a secure note named "dotfiles/<name>".
SECRETS_FILE="$HOME/.config/dotfiles/secrets"

g() { git --git-dir="$DOT_DIR" --work-tree="$HOME" "$@"; }
# msg <colour code> <text...>: status line on stderr, coloured on a terminal
msg() {
    local colour=$1
    shift
    if [[ -t 2 ]]; then
        printf '\033[1;%sm::\033[0m %s\n' "$colour" "$*" >&2
    else
        printf ':: %s\n' "$*" >&2
    fi
}
info() { msg 34 "$@"; }
warn() { msg 33 "$@"; }
die() {
    msg 31 "$@"
    exit 1
}

# Read $SECRETS_FILE into SECRETS as "name|path" entries. Missing file (e.g.
# during bootstrap, before checkout) means no secrets.
load_secrets() {
    SECRETS=()
    [[ -f $SECRETS_FILE ]] || return 0
    local name path
    while read -r name path; do
        [[ -z $name || $name == \#* ]] && continue
        SECRETS+=("$name|$path")
    done <"$SECRETS_FILE"
}

# Keep secret paths ignored so a stray `dot add` refuses them.
write_excludes() {
    local entry
    {
        echo "# managed by dot - secret files, see 'dot secrets'"
        for entry in "${SECRETS[@]}"; do echo "/${entry#*|}"; done
    } >"$DOT_DIR/info/exclude"
}

cmd_bootstrap() {
    local url="${1:-$DOT_URL}"
    [[ -e $DOT_DIR ]] && die "$DOT_DIR already exists"
    command -v git >/dev/null || die "git is required"

    info "cloning $url"
    git clone --bare "$url" "$DOT_DIR"
    g config status.showUntrackedFiles no
    [[ $url == "$DOT_URL" ]] && g remote set-url --push origin "$DOT_PUSH_URL"

    # Back up any existing files that would be overwritten by checkout.
    local backup f
    backup="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
    while IFS= read -r f; do
        [[ -e $HOME/$f || -L $HOME/$f ]] || continue
        mkdir -p "$backup/$(dirname "$f")"
        mv "$HOME/$f" "$backup/$f"
    done < <(g ls-tree -r --name-only HEAD)
    [[ -d $backup ]] && info "backed up existing files to $backup"

    g checkout
    load_secrets
    cmd_setup
    info "done - run 'dot secrets pull' to fetch private config from Bitwarden"
}

# Refuse commits whose added lines match the private denylist (regexes, one per
# line, case-insensitive). The list itself is a secret, so it can't live in the
# public repo; without it the hook does nothing.
write_hook() {
    mkdir -p "$DOT_DIR/hooks"
    cat >"$DOT_DIR/hooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
# installed by `dot setup`
list="$HOME/.config/dotfiles/denylist"
[[ -s $list ]] || exit 0
patterns=$(grep -Ev '^[[:space:]]*(#|$)' "$list") || exit 0
if hits=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -Ev '^\+\+\+ ' |
    grep -inE -- "$patterns"); then
    printf '\033[1;31m::\033[0m commit blocked, staged lines match %s:\n%s\n' "$list" "$hits" >&2
    exit 1
fi
EOF
    chmod +x "$DOT_DIR/hooks/pre-commit"
}

cmd_setup() {
    write_excludes
    write_hook
    chmod 700 "$HOME/.ssh" 2>/dev/null || true

    # stdin from /dev/null: fisher reads plugin names from a non-tty stdin, which
    # under `curl ... | bash` would be the rest of this script
    if command -v fish >/dev/null; then
        info "installing fisher plugins"
        fish -c 'type -q fisher; or curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source; fisher update' </dev/null ||
            warn "fisher update failed"
    fi

    local list="$HOME/.config/dotfiles/omarchy-plugins" url plugin
    if command -v omarchy >/dev/null && [[ -f $list ]]; then
        info "installing omarchy shell plugins"
        while IFS= read -r url; do
            [[ -z $url || $url == \#* ]] && continue
            plugin=${url##*/}
            plugin=${plugin%.git}
            omarchy plugin list 2>/dev/null | grep -qF "${plugin#omarchy-}" && continue
            omarchy plugin add "$url" --yes </dev/null || warn "failed to add $url"
        done <"$list"
    fi
}

# All vault access goes through one `bw serve` process per dot run: every bw
# invocation costs ~1-5s (node startup, reading and decrypting the vault),
# requests to a running server ~20ms. It listens on a unix socket in a private
# 0700 directory, so only this user can reach it; if this bw can't do that
# (undocumented `unix://` hostname), it falls back to 127.0.0.1 on a random port.
bw_start() {
    BW_DIR=$(mktemp -d -p "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}" dot-bw.XXXXXX)
    trap bw_stop EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    bw_serve_socket && return
    # bw serve refuses to start while logged out. Only checked after a failed
    # start, so the usual run doesn't pay for an extra ~2s bw call.
    if [[ $(bw status | jq -r .status) == unauthenticated ]]; then
        bw_login
        bw_serve_socket && return
    fi

    warn "bw serve can't listen on a unix socket, falling back to 127.0.0.1"
    local port=$((20000 + RANDOM % 20000))
    bw serve --hostname 127.0.0.1 --port "$port" >"$BW_DIR/log" 2>&1 &
    BW_PID=$!
    BW_CURL=()
    BW_BASE=http://127.0.0.1:$port
    bw_wait || die "bw serve didn't start: $(tail -n3 "$BW_DIR/log")"
}

bw_serve_socket() {
    rm -f "$BW_DIR/bw.sock"
    bw serve --hostname "unix://$BW_DIR/bw.sock" >"$BW_DIR/log" 2>&1 &
    BW_PID=$!
    # bw serve rejects Host headers it doesn't expect, even on a socket
    BW_CURL=(--unix-socket "$BW_DIR/bw.sock" -H "Host: localhost:8087")
    BW_BASE=http://localhost
    bw_wait && return
    bw_kill
    return 1
}

# Wait up to ~15s for the server; fails early if it exited.
bw_wait() {
    local i
    for ((i = 0; i < 300; i++)); do
        bw_alive || return 1
        curl -fs "${BW_CURL[@]}" "$BW_BASE/status" >/dev/null 2>&1 && return 0
        sleep 0.05
    done
    return 1
}

# kill -0 also succeeds for an exited but not yet reaped (zombie) process
bw_alive() {
    local state
    [[ -r /proc/$BW_PID/stat ]] && read -r _ _ state _ <"/proc/$BW_PID/stat" && [[ $state != Z ]]
}

bw_kill() {
    kill "$BW_PID" 2>/dev/null || true
    wait "$BW_PID" 2>/dev/null || true
}

bw_stop() {
    [[ -z ${BW_PID-} ]] || bw_kill
    [[ -z ${BW_DIR-} ]] || rm -rf "$BW_DIR"
}

# api <method> <path> [curl args...]: prints the response's .data, dies with
# bitwarden's message on failure. Inside a pipeline or $(...), die only ends
# that subshell; pipefail and set -e then stop the script.
api() {
    local method=$1 path=$2 out
    shift 2
    out=$(curl -sS "${BW_CURL[@]}" -X "$method" "$@" "$BW_BASE$path") ||
        die "request to bw serve failed: $method $path"
    jq -e '.success' >/dev/null 2>&1 <<<"$out" ||
        die "bitwarden: $(jq -r '.message // empty' <<<"$out" 2>/dev/null || echo "$out")"
    jq -c '.data' <<<"$out"
}

# api_json <method> <path>: like api, with a JSON request body on stdin.
api_json() { api "$1" "$2" -H 'Content-Type: application/json' --data-binary @-; }

# First run on a machine: interactive `bw login`. --raw prints only the session
# key (the prompts go to stderr), exported so the bw serve started next comes up
# already unlocked instead of asking for the master password again.
bw_login() {
    local session
    { : </dev/tty; } 2>/dev/null || die "not logged in to Bitwarden and there's no terminal, run 'bw login' first"
    info "not logged in to Bitwarden, running 'bw login'"
    session=$(bw login --raw </dev/tty) || die "bw login failed"
    export BW_SESSION=$session
}

bw_session() {
    local cmd
    for cmd in bw jq curl; do
        command -v "$cmd" >/dev/null || die "$cmd is required for dot secrets"
    done
    bw_start
    case $(api GET /status | jq -r .template.status) in
    unauthenticated) die "run 'bw login' first" ;;
    locked)
        local pw
        { : </dev/tty; } 2>/dev/null || die "vault is locked and there's no terminal, set BW_SESSION"
        read -rsp "? Master password: " pw </dev/tty
        echo >&2
        # via the environment, so the password never shows up in argv
        PW=$pw jq -n '{password: env.PW}' | api_json POST /unlock >/dev/null
        ;;
    esac
    api POST /sync >/dev/null
}

# Resolve requested names (default: all) into ENTRIES as "name|path". Called
# directly, not in a subshell, so an unknown name stops the script.
select_secrets() {
    local entry name
    ENTRIES=()
    if (($# == 0)); then
        ENTRIES=("${SECRETS[@]}")
        return
    fi
    for name in "$@"; do
        for entry in "${SECRETS[@]}"; do
            if [[ ${entry%%|*} == "$name" ]]; then
                ENTRIES+=("$entry")
                continue 2
            fi
        done
        die "unknown secret '$name' (known: ${SECRETS[*]%%|*})"
    done
}

# Fetch all dotfiles notes once, the rest works on this list.
load_items() {
    ITEMS=$(api GET "/list/object/items?search=dotfiles%2F" | jq -c '.data')
}

# Prints the stored item JSON for an exact name match, or nothing.
item_json() {
    jq -c --arg n "dotfiles/$1" 'first(.[] | select(.name == $n)) // empty' <<<"$ITEMS"
}

# Notes hold at most 10000 encrypted characters (~7.4 KB of text). Larger or
# binary files go into an attachment on the same item (needs Premium); its
# notes then carry a marker with the file's checksum and attachment id.
NOTE_MAX_BYTES=7000
MARKER_RE='^dot:attachment sha256=([0-9a-f]{64}) id=([^[:space:]]+)'

# True for text files small enough to store as a note: within the size limit,
# no NUL bytes (valid UTF-8, but not in a note) and valid UTF-8.
fits_note() {
    (($(wc -c <"$1") <= NOTE_MAX_BYTES)) &&
        (($(tr -dc '\000' <"$1" | wc -c) == 0)) &&
        iconv -f UTF-8 -t UTF-8 "$1" >/dev/null 2>&1
}

sha256() { sha256sum "$1" | cut -d' ' -f1; }

# create_item <name> <jq args defining $n>: new secure note, prints its JSON.
create_item() {
    local name=$1
    shift
    jq -n --arg name "dotfiles/$name" "$@" \
        '{type: 2, name: $name, notes: $n, secureNote: {type: 0}, organizationId: null,
          folderId: null, favorite: false, fields: [], reprompt: 0}' |
        api_json POST /object/item
}

# set_notes <item json> <jq args defining $n>: replace the notes, prints the item.
set_notes() {
    local item=$1
    shift
    jq "$@" '.notes = $n' <<<"$item" | api_json PUT "/object/item/$(jq -r .id <<<"$item")"
}

# delete_attachments <item id> <attachment id...>
delete_attachments() {
    local item_id=$1 att
    shift
    for att in "$@"; do
        api DELETE "/object/attachment/$att?itemid=$item_id" >/dev/null
    done
}

push_secret() {
    local name=$1 path=$2 item old hash marker new_id
    item=$(item_json "$name")

    if fits_note "$path"; then
        if [[ -z $item ]]; then
            create_item "$name" --rawfile n "$path" >/dev/null
            info "created dotfiles/$name"
        elif jq -e --rawfile n "$path" '.notes == $n' <<<"$item" >/dev/null; then
            info "unchanged dotfiles/$name"
        else
            mapfile -t old < <(jq -r '.attachments[]?.id' <<<"$item")
            set_notes "$item" --rawfile n "$path" >/dev/null
            # drop attachments left from when the file was too large for a note
            delete_attachments "$(jq -r .id <<<"$item")" "${old[@]}"
            info "updated dotfiles/$name"
        fi
        return
    fi

    hash=$(sha256 "$path")
    if [[ -n $item && $(jq -r '.notes // ""' <<<"$item") =~ $MARKER_RE ]] &&
        [[ ${BASH_REMATCH[1]} == "$hash" ]] &&
        jq -e --arg id "${BASH_REMATCH[2]}" 'any(.attachments[]?; .id == $id)' <<<"$item" >/dev/null; then
        info "unchanged dotfiles/$name (attachment)"
        return
    fi
    [[ -n $item ]] || item=$(create_item "$name" --arg n "dot:attachment pending")
    mapfile -t old < <(jq -r '.attachments[]?.id' <<<"$item")

    # Upload first, then point the marker at it, then remove old attachments,
    # so an interrupted push leaves the previous version intact.
    item=$(api POST "/attachment?itemid=$(jq -r .id <<<"$item")" -F "file=@$path")
    new_id=$(jq -r --args '[.attachments[] | select([.id] | inside($ARGS.positional) | not)][0].id // empty' \
        "${old[@]}" <<<"$item")
    [[ -n $new_id ]] || die "uploading $name failed"
    marker="dot:attachment sha256=$hash id=$new_id"$'\n\n'"Stored as an attachment by dot: too large or binary for a note."
    item=$(set_notes "$item" --arg n "$marker")
    delete_attachments "$(jq -r .id <<<"$item")" "${old[@]}"
    info "uploaded dotfiles/$name (attachment, $(wc -c <"$path") bytes)"
}

pull_secret() {
    local name=$1 path=$2 item tmp hash
    item=$(item_json "$name")
    if [[ -z $item ]]; then
        warn "skipping $name: no 'dotfiles/$name' note in bitwarden"
        return
    fi
    mkdir -p "$(dirname "$path")"
    # temp file next to the target (0600 from mktemp), so the final mv is an
    # atomic rename on the same filesystem
    tmp=$(mktemp "$path.XXXXXX")
    if [[ $(jq -r '.notes // ""' <<<"$item") =~ $MARKER_RE ]]; then
        hash=${BASH_REMATCH[1]}
        if ! curl -fsS "${BW_CURL[@]}" -o "$tmp" \
            "$BW_BASE/object/attachment/${BASH_REMATCH[2]}?itemid=$(jq -r .id <<<"$item")"; then
            rm -f "$tmp"
            die "downloading the attachment of $name failed"
        fi
        if [[ $(sha256 "$tmp") != "$hash" ]]; then
            rm -f "$tmp"
            die "checksum mismatch for $name, ~/${path#"$HOME"/} left unchanged"
        fi
    else
        jq -j '.notes // ""' <<<"$item" >"$tmp"
    fi
    mv "$tmp" "$path"
    info "pulled $name -> ~/${path#"$HOME"/}"
}

# dot secrets add <name> <file>: register a file under $HOME and push it.
secrets_add() {
    (($# == 2)) || die "usage: dot secrets add <name> <file>"
    local name=$1 file rel entry
    [[ $name =~ ^[a-z0-9][a-z0-9._-]*$ ]] ||
        die "invalid name '$name' (lowercase letters, digits, '.', '_', '-')"
    file=$(realpath -s -- "$2")
    [[ -f $file ]] || die "not a file: $2"
    [[ $file == "$HOME"/* ]] || die "$2 is not inside $HOME"
    rel=${file#"$HOME"/}
    [[ $rel != *[[:space:]]* ]] || die "paths with whitespace aren't supported"
    for entry in "${SECRETS[@]}"; do
        [[ ${entry%%|*} != "$name" ]] || die "secret '$name' already exists (~/${entry#*|})"
        [[ ${entry#*|} != "$rel" ]] || die "file ~/$rel is already the secret '${entry%%|*}'"
    done
    if g -C "$HOME" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
        die "file ~/$rel is tracked in the repo, untrack it first: dot rm --cached ~/$rel"
    fi

    mkdir -p "$(dirname "$SECRETS_FILE")"
    # keep the file newline-terminated before appending
    if [[ -s $SECRETS_FILE && $(tail -c1 "$SECRETS_FILE") ]]; then echo >>"$SECRETS_FILE"; fi
    printf '%-16s %s\n' "$name" "$rel" >>"$SECRETS_FILE"
    SECRETS+=("$name|$rel")
    write_excludes
    info "added $name -> ~/$rel"

    cmd_secrets push "$name"
    info "commit ~/${SECRETS_FILE#"$HOME"/} so other machines can 'dot secrets pull $name'"
}

# dot secrets status [name...]: compare each file with Bitwarden, like git
# status. Notes are compared by content, attachments by the checksum in their
# marker, so nothing is downloaded. There's no sync history, so a difference
# can't tell which side changed. Without names, also shows dotfiles/* items
# that are no longer configured.
secrets_status() {
    local entry name path item stored state hash size
    select_secrets "$@"
    bw_session
    load_items
    printf '%-16s %-30s %-22s %s\n' NAME FILE BITWARDEN STATE
    for entry in "${ENTRIES[@]}"; do
        name=${entry%%|*} path="$HOME/${entry#*|}"
        item=$(item_json "$name")
        if [[ -z $item ]]; then
            stored="not stored"
            state="missing everywhere"
            [[ ! -f $path ]] || state="not pushed yet"
        elif [[ $(jq -r '.notes // ""' <<<"$item") =~ $MARKER_RE ]]; then
            hash=${BASH_REMATCH[1]}
            size=$(jq -r --arg id "${BASH_REMATCH[2]}" \
                'first(.attachments[]? | select(.id == $id) | .sizeName // "\(.size) bytes") // empty' <<<"$item")
            stored="attachment, ${size:-missing}"
            if [[ -z $size ]]; then
                state="attachment missing (push)"
            elif [[ ! -f $path ]]; then
                state="missing locally (pull)"
            elif [[ $(sha256 "$path") == "$hash" ]]; then
                state="in sync"
            else
                state=differs
            fi
        else
            stored="note, $(jq -j '.notes // ""' <<<"$item" | wc -c) bytes"
            if [[ ! -f $path ]]; then
                state="missing locally (pull)"
            elif jq -e --rawfile n "$path" '.notes == $n' <<<"$item" >/dev/null; then
                state="in sync"
            else
                state=differs
            fi
        fi
        printf '%-16s ~/%-28s %-22s %s\n' "$name" "${entry#*|}" "$stored" "$state"
    done
    (($# == 0)) || return 0
    jq -r --args '.[] | .name | select(startswith("dotfiles/")) | ltrimstr("dotfiles/")
        | select(IN($ARGS.positional[]) | not)' "${SECRETS[@]%%|*}" <<<"$ITEMS" |
        while read -r name; do
            printf '%-16s %-30s %-22s %s\n' "$name" - - "not configured"
        done
}

# dot secrets rm [--keep-vault] <name>: drop a secret from the list and the git
# excludes and move its item to the Bitwarden trash (restorable for 30 days).
# The local file stays.
secrets_rm() {
    local keep_vault=false name rel item tmp
    if [[ ${1-} == --keep-vault ]]; then
        keep_vault=true
        shift
    fi
    (($# == 1)) || die "usage: dot secrets rm [--keep-vault] <name>"
    name=$1
    select_secrets "$name"
    rel=${ENTRIES[0]#*|}

    if ! $keep_vault; then
        bw_session
        load_items
        item=$(item_json "$name")
        if [[ -n $item ]]; then
            api DELETE "/object/item/$(jq -r .id <<<"$item")" >/dev/null
            info "moved dotfiles/$name to the bitwarden trash"
        else
            warn "no 'dotfiles/$name' item in bitwarden"
        fi
    fi

    tmp=$(mktemp)
    awk -v n="$name" '$1 != n' "$SECRETS_FILE" >"$tmp"
    cat "$tmp" >"$SECRETS_FILE"
    rm -f "$tmp"
    load_secrets
    write_excludes
    info "removed $name from ~/${SECRETS_FILE#"$HOME"/}"
    warn "file ~/$rel is no longer excluded from git, delete it or keep it out of 'dot add'"
}

cmd_secrets() {
    local action="${1:-status}"
    shift || true
    case $action in
    ls) action=list ;;
    remove) action="rm" ;;
    st) action=status ;;
    esac
    case $action in
    add | rm | status)
        "secrets_$action" "$@"
        return
        ;;
    list | pull | push) ;;
    *) die "usage: dot secrets list|pull|push|status [name...] | add <name> <file> | rm [--keep-vault] <name>" ;;
    esac
    local entry name path
    select_secrets "$@"

    case $action in
    list)
        printf '%-16s %-30s %s\n' NAME FILE LOCAL
        for entry in "${ENTRIES[@]}"; do
            path="$HOME/${entry#*|}"
            printf '%-16s ~/%-28s %s\n' "${entry%%|*}" "${entry#*|}" "$([[ -f $path ]] && echo present || echo missing)"
        done
        ;;
    pull)
        bw_session
        load_items
        for entry in "${ENTRIES[@]}"; do
            pull_secret "${entry%%|*}" "$HOME/${entry#*|}"
        done
        ;;
    push)
        bw_session
        load_items
        for entry in "${ENTRIES[@]}"; do
            name=${entry%%|*} path="$HOME/${entry#*|}"
            [[ -f $path ]] || {
                (($# > 0)) && warn "skipping $name: ~/${entry#*|} missing"
                continue
            }
            push_secret "$name" "$path"
        done
        ;;
    esac
}

load_secrets

case "${1:-}" in
bootstrap)
    shift
    cmd_bootstrap "$@"
    ;;
setup) cmd_setup ;;
secrets | secret)
    shift
    cmd_secrets "$@"
    ;;
"") g status ;;
*) g "$@" ;;
esac
